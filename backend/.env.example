# ====================================================================
# CoalGuard AI Backend Environment Configuration Template
# ====================================================================

# Database Connection (SQLite default for local, PostgreSQL for Railway production)
# Local: sqlite:///./coalguard.db
# Railway: postgresql://postgres:password@host:port/railway (or Railway Postgres plugin DATABASE_URL)
DATABASE_URL=sqlite:///./coalguard.db

# Project & API Configuration
PROJECT_NAME="CoalGuard AI"
API_V1_STR=/api

# Security & JWT Token Config (Use a strong random secret in production)
SECRET_KEY=replace_with_secure_production_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated URLs or frontend production domain)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
